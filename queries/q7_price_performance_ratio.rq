# Query 7: Price-Performance Ratio Ranking
# Description: Computes virtual CPUs per dollar ratio (?cpu / ?cost) to rank compute services by hardware cost-efficiency.
PREFIX cloud: <https://w3id.org/cloud-interoperability#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?service ?provider ?cpu ?cost ((?cpu / ?cost) AS ?vCpuPerDollar) WHERE {
  ?service rdf:type cloud:ComputeService .
  ?service cloud:providedBy ?provider .
  ?service cloud:hasCPUValue ?cpu .
  ?service cloud:hasCostPerHour ?cost .
  FILTER(?cost > 0)
}
ORDER BY DESC(?vCpuPerDollar)
