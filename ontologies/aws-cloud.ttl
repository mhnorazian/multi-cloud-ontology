@prefix cloud: <https://w3id.org/cloud-interoperability#> .
@prefix aws:   <https://w3id.org/aws-cloud#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/aws-cloud> a owl:Ontology ;
    owl:imports <https://w3id.org/cloud-interoperability> ;
    rdfs:label "AWS Cloud Ontology" .

aws:AWSProvider a cloud:AWS ;
    rdfs:label "AWS Provider" .

aws:EC2Instance a owl:Class ;
    rdfs:subClassOf cloud:ComputeService ;
    rdfs:label "EC2Instance" ;
    cloud:mappedToCoreService cloud:ComputeService .

aws:S3Bucket a owl:Class ;
    rdfs:subClassOf cloud:ObjectStorageService ;
    rdfs:label "S3Bucket" ;
    cloud:mappedToCoreService cloud:ObjectStorageService .

aws:EBSVolume a owl:Class ;
    rdfs:subClassOf cloud:BlockStorageService ;
    rdfs:label "EBSVolume" ;
    cloud:mappedToCoreService cloud:BlockStorageService .

aws:RDSInstance a owl:Class ;
    rdfs:subClassOf cloud:DatabaseService ;
    rdfs:label "RDSInstance" ;
    cloud:mappedToCoreService cloud:DatabaseService .

aws:VPCNetwork a owl:Class ;
    rdfs:subClassOf cloud:NetworkService ;
    rdfs:label "VPCNetwork" ;
    cloud:mappedToCoreService cloud:NetworkService .

aws:LambdaFunction a owl:Class ;
    rdfs:subClassOf cloud:ComputeService ;
    rdfs:label "LambdaFunction" .

aws:AvailabilityZone a owl:Class ;
    rdfs:subClassOf cloud:Region ;
    rdfs:label "AvailabilityZone" .

aws:InstanceFamily a owl:Class ;
    rdfs:subClassOf cloud:ServiceAttribute ;
    rdfs:label "InstanceFamily" .
