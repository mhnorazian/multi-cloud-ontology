@prefix cloud: <https://w3id.org/cloud-interoperability#> .
@prefix os:    <https://w3id.org/openstack-cloud#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/openstack-cloud> a owl:Ontology ;
    owl:imports <https://w3id.org/cloud-interoperability> ;
    rdfs:label "OpenStack Cloud Ontology" .

os:OpenStackProvider a cloud:OpenStack ;
    rdfs:label "OpenStack Provider" .

os:NovaInstance a owl:Class ;
    rdfs:subClassOf cloud:ComputeService ;
    rdfs:label "NovaInstance" ;
    cloud:mappedToCoreService cloud:ComputeService .

os:SwiftStorage a owl:Class ;
    rdfs:subClassOf cloud:ObjectStorageService ;
    rdfs:label "SwiftStorage" ;
    cloud:mappedToCoreService cloud:ObjectStorageService .

os:CinderVolume a owl:Class ;
    rdfs:subClassOf cloud:BlockStorageService ;
    rdfs:label "CinderVolume" ;
    cloud:mappedToCoreService cloud:BlockStorageService .

os:TroveDatabase a owl:Class ;
    rdfs:subClassOf cloud:DatabaseService ;
    rdfs:label "TroveDatabase" ;
    cloud:mappedToCoreService cloud:DatabaseService .

os:NeutronNetwork a owl:Class ;
    rdfs:subClassOf cloud:NetworkService ;
    rdfs:label "NeutronNetwork" ;
    cloud:mappedToCoreService cloud:NetworkService .

os:Flavor a owl:Class ;
    rdfs:subClassOf cloud:ServiceAttribute ;
    rdfs:label "Flavor" .

os:Tenant a owl:Class ;
    rdfs:subClassOf cloud:CloudConsumer ;
    rdfs:label "Tenant" .

os:GlanceImage a owl:Class ;
    rdfs:subClassOf cloud:ServiceAttribute ;
    rdfs:label "GlanceImage" .
